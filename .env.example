# Copy to .env and fill in real values (`.env` is gitignored).
# Credential-free checks never need these: `uv run pytest -q`.

# Required: Pinecone serverless index + OpenAI embeddings.
PINECONE_API_KEY=your-pinecone-api-key
OPENAI_API_KEY=your-openai-api-key
INDEX_NAME=rag-pytest

# Retrieval configuration. Both weights must be positive and sum to 1.0.
PINECONE_NAMESPACE=rag-docs
ENSEMBLE_BM25_WEIGHT=0.4
ENSEMBLE_VECTOR_WEIGHT=0.6

# Optional overrides (defaults shown).
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# CHUNK_SIZE=600
# CHUNK_OVERLAP=80
# UPSERT_BATCH_SIZE=32
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# PIPELINE_VERSION=1
